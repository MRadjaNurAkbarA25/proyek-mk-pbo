# Daftar environment variable untuk SERVER.
#
# Proyek ini TIDAK membaca berkas .env secara otomatis. Berkas ini hanya
# acuan: isi variabel-variabel di bawah lewat pengaturan environment di
# server (panel hosting, docker -e, atau systemd). Di laptop tidak ada yang
# perlu diisi; nilai bawaannya sudah cocok untuk mengembangkan.

# --- Wajib di server -------------------------------------------------------

# Kunci rahasia baru. JANGAN pakai yang tertulis di settings.py (repo publik).
# Buat dengan:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# 0 = mati. Bawaannya 1 (menyala) supaya nyaman di laptop.
DJANGO_DEBUG=0

DJANGO_ALLOWED_HOSTS=bengkelsiaga.pbo.web.id
DJANGO_CSRF_TRUSTED_ORIGINS=https://bengkelsiaga.pbo.web.id

# 1 = cookie login hanya dikirim lewat https.
DJANGO_HTTPS=1

# Folder di volume terpisah. Berisi db.sqlite3, media/ (foto profil), dan
# privat/ (bukti pembayaran, tidak dilayani publik), supaya data tidak hilang
# saat kontainer dibangun ulang.
DJANGO_DATA_DIR=/data

# Catatan: kalau DJANGO_ALLOWED_HOSTS berisi domain publik, aplikasi menolak
# menyala selama DJANGO_DEBUG=1 atau DJANGO_SECRET_KEY kosong.

# --- Opsional: e-mail untuk Lupa Kata Sandi -------------------------------
# Selama DJANGO_EMAIL_HOST kosong, halaman Lupa Kata Sandi di server
# mengarahkan pengguna ke kontak bengkel, dan admin yang mengganti kata
# sandinya (Kelola Pelanggan / Kasir / Mekanik > Ubah).
# Contoh Gmail: buat "App password" di akun Google (butuh verifikasi 2 langkah).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_TLS=1
DJANGO_EMAIL_FROM=

# --- Sekali pakai: data demo -----------------------------------------------
# Hanya saat menjalankan seed_demo di server, bukan disimpan permanen:
#   DJANGO_SANDI_DEMO='kata-sandi-pilihan' python manage.py seed_demo
# DJANGO_SANDI_DEMO=
